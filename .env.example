# Cả hai key đều KHÔNG bắt buộc.
# Không có key nào thì app vẫn chạy đủ cho Ngoại hạng Anh và La Liga
# (lịch thi đấu, bảng xếp hạng, sức mạnh đội bóng, dự đoán) qua openfootball.

# Kèo nhà cái cho trận sắp tới — nguồn cải thiện độ chính xác lớn nhất
# (54.9% so với 51.2% của mô hình thuần). Miễn phí 500 lượt/tháng:
# https://the-odds-api.com/
ODDS_API_KEY=

# Cần cho Champions League. Đăng ký miễn phí:
# https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=

# Cần cho dữ liệu chấn thương và đội hình ra sân. Miễn phí 100 lượt/ngày:
# https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
